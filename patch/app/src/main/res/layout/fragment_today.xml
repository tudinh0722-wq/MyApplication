<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: HÔM NAY · Thứ 3, 12/08 -->
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HÔM NAY"
            android:textSize="13sp"
            android:textColor="@color/label_gray"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="12dp" />

        <!-- 3 stat cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <!-- Xưởng -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_work"
                android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xưởng"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.75"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tv_total_work"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Thiết kế -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_design"
                android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thiết kế"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.75"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tv_total_design"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- CNC -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_cnc"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CNC"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.75"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tv_total_cnc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Timeline -->
        <com.example.chamcong.TimelineView
            android:id="@+id/timeline_view"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp" />

        <!-- Event log -->
        <TextView
            android:id="@+id/tv_event_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có sự kiện nào."
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingMultiplier="1.6"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
